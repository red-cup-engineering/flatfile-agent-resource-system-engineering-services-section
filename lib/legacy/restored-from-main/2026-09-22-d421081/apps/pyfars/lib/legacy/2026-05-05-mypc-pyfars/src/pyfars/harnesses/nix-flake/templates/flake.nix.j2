# {{ polity.title or "(missing polity)" }} — flake.nix
#
# Harness-generated by `{{ generation_command }}` at {{ generated_at }}.
# Do not hand-edit. Edit the template at
# operations/engineering/harnesses/nix-flake/templates/flake.nix.j2
# and re-run the install command.
#
# This flake is the polity's projection into Nix. Each computer system
# the polity has registered (under operations/command/group/computer-systems/)
# with a nix-system declared appears as its own
# devShells.<system>.<computer-system-slug> output below. Computer systems
# are substrate entities; their per-system attributes here are derived,
# not authored in this file.

{
  description = "{{ polity.title or "561 Group operational substrate" }} — operational substrate (pyfars)";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";
    flake-utils.url = "github:numtide/flake-utils";
    # pyfars is the polity's substrate runtime (PyFARS — the Python
    # implementation of the FARS architecture), hosted as its own flake;
    # the source of truth lives at github.com/emsenn/pyfars and is consumed
    # here as an input rather than vendored in-tree. The git+ssh URL form
    # is used (rather than the github: shorthand) because the repo is
    # private — Nix's github: scheme uses the public API and 404s on
    # private repos; git+ssh uses the SSH agent's existing auth.
    pyfars = {
      url = "git+ssh://git@github.com/emsenn/pyfars";
      inputs.nixpkgs.follows = "nixpkgs";
      inputs.flake-utils.follows = "flake-utils";
    };
  };

  outputs = { self, nixpkgs, flake-utils, pyfars }:
    let
      # Polity's computer systems (substrate-derived). Each entry is one
      # system that has declared a nix-system; systems without one are
      # absent. Non-digital units (e.g. ships in the body-politic sense)
      # are intentionally not enumerated here.
      polityComputerSystems = [
{%- for cs in computer_systems %}
        {
          slug = "{{ cs.slug }}";
          title = "{{ cs.title }}";
          description = "{{ cs.description }}";
          nixSystem = "{{ cs.nix_system }}";
          role = "{{ cs.role }}";
        }
{%- endfor %}
      ];
    in
    flake-utils.lib.eachDefaultSystem (system:
      let
        pkgs = nixpkgs.legacyPackages.${system};
        lib = pkgs.lib;
        python = pkgs.python313;

        pyfarsPkg = pyfars.packages.${system}.default;

        commonShellPackages = [
          python
          pyfarsPkg
          pkgs.git
        ];

        mkSystemShell = cs: pkgs.mkShell {
          name = "${cs.slug}-devshell";
          packages = commonShellPackages;
          shellHook = ''
            echo "{{ polity.title or "561 Group" }} — computer system: ${cs.title} (${cs.role})"
            echo "  ${cs.description}"
            echo "  python: $(${python}/bin/python --version)"
            echo "  pyfars: $(command -v pyfars)"
          '';
        };

        # Computer systems whose declared nix-system matches the system
        # this flake output is being evaluated for. Other systems'
        # devShells are not emitted on this Nix system.
        systemsForThisSystem = lib.filter
          (cs: cs.nixSystem == system) polityComputerSystems;
        systemShells = lib.listToAttrs (map
          (cs: { name = cs.slug; value = mkSystemShell cs; })
          systemsForThisSystem);

      in {
        packages = {
          pyfars = pyfarsPkg;
          default = pyfarsPkg;
        };

        devShells = systemShells // {
          default = pkgs.mkShell {
            name = "polity-561-group-devshell";
            packages = commonShellPackages;
            shellHook = ''
              echo "{{ polity.title or "561 Group" }} — generic devshell"
              echo "  (no computer system matched this host's Nix system; using polity-default shell)"
              echo "  python: $(${python}/bin/python --version)"
              echo "  pyfars: $(command -v pyfars)"
            '';
          };
        };

        apps.pyfars = {
          type = "app";
          program = "${pyfarsPkg}/bin/pyfars";
        };
      });
}
