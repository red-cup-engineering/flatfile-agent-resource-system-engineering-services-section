{
  "name": "@red-cup-engineering/fae",
  "version": "0.2.0",
  "type": "module",
  "description": "FAE — the Node Flatfile Agent Engine that reads flatfiles and provider observations into a FARS graph.",
  "license": "UNLICENSED",
  "files": [
    "src",
    "types",
    "README.md",
    "package.json"
  ],
  "bin": {
    "fae": "src/cli/fae.mjs"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.mts",
      "import": "./src/index.mjs"
    },
    "./cli": {
      "import": "./src/cli/verbs.mjs"
    },
    "./provider": {
      "types": "./types/provider.d.mts",
      "import": "./src/provider/provider.mjs"
    },
    "./compositor": {
      "types": "./types/compositor.d.mts",
      "import": "./src/provider/compositor.mjs"
    },
    "./inspection": {
      "types": "./types/inspection.d.mts",
      "import": "./src/inspect-resource.mjs"
    },
    "./attribute-projection": {
      "types": "./types/attribute-projection.d.mts",
      "import": "./src/provider/attribute-projection.mjs"
    },
    "./renderer": {
      "types": "./types/renderer.d.mts",
      "import": "./src/render/registry.mjs"
    },
    "./adapters/activity-pulse": {
      "types": "./types/adapters.d.mts",
      "import": "./src/adapters/activity-pulse.mjs"
    },
    "./adapters/host-health": {
      "types": "./types/adapters.d.mts",
      "import": "./src/adapters/host-health.mjs"
    },
    "./adapters/linux-processes": {
      "types": "./types/adapters.d.mts",
      "import": "./src/adapters/linux-processes.mjs"
    },
    "./adapters/markdown-directory": {
      "types": "./types/adapters.d.mts",
      "import": "./src/adapters/markdown-directory.mjs"
    },
    "./adapters/package-json-directory": {
      "types": "./types/adapters.d.mts",
      "import": "./src/adapters/package-json-directory.mjs"
    },
    "./adapters/systemd-inventory": {
      "types": "./types/adapters.d.mts",
      "import": "./src/adapters/systemd-inventory.mjs"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@lenticule-science/articulating": "0.2.6",
    "@red-cup-engineering/canonical-json-service": "0.2.1",
    "@red-cup-engineering/canonicalize-semiotic-json-service": "0.0.1",
    "@red-cup-engineering/computer-data-type-engine": "0.4.0",
    "@red-cup-engineering/drew": "0.1.1",
    "@red-cup-engineering/eavt": "0.2.0",
    "@red-cup-engineering/frog": "0.4.1",
    "@red-cup-engineering/javascript-file-main-guard-service": "0.1.3",
    "@red-cup-engineering/jsnode-engineering-cli": "0.4.1",
    "@red-cup-engineering/ni-services-section": "0.1.1",
    "@red-cup-engineering/path-walking-service": "0.1.0",
    "@red-cup-engineering/read-javascript-node-standard-input-text-service": "0.1.0",
    "@red-cup-engineering/read-markdown-features-service": "0.1.0",
    "@red-cup-engineering/read-markdown-frontmatter-service": "0.1.4",
    "@red-cup-engineering/relation-model-notation-json-codec": "0.2.1",
    "@red-cup-engineering/relation-model-notation-runtime": "0.10.0",
    "@red-cup-engineering/replace-markdown-link-target-service": "0.1.0",
    "@red-cup-engineering/review-jsnode-package-service": "0.1.8",
    "@red-cup-engineering/witness-journal-entry-service": "0.3.0",
